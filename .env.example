# yard-sale-gold — Docker / server configuration.
# Copy to `.env` in the same folder as docker-compose.yml (gitignored).
# Docker Compose passes OPENAI_API_KEY into the container; the entrypoint
# writes dist/yard_sale_gold/.dev.vars for Wrangler at startup.
# For local `npm run dev` (no Docker), use `.dev.vars` at the repo root instead.

# Required: OpenAI or OpenRouter key
OPENAI_API_KEY=sk-or-v1-...

# Model for frame analysis (default matches wrangler.jsonc)
OPENAI_MODEL=gpt-5.6-luna

# Port the app listens on inside the container (Docker maps this).
# PORT=5174
