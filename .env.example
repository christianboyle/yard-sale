# yard-sale-gold — Docker / server configuration.
# Copy to `.env` (gitignored; read by docker-compose.yml).
# For local `npm run dev`, use `.dev.vars` instead (Wrangler reads that file).

# Required: OpenAI or OpenRouter key
OPENAI_API_KEY=sk-or-v1-...

# Model for frame analysis (default matches wrangler.jsonc)
OPENAI_MODEL=gpt-5.6-luna

# Port the app listens on inside the container (Docker maps this).
# PORT=5174
